# Safe default: no TikTok connection.
LIVE_MODE=fake
# FastAPI UI: false = observation/Playground only. CLI listener ignores this flag.
ADMIN_LIVE_ENABLED=false
# Trusted startup only; never enable from the browser. RC needs operator Profile/LIVE/Send verification.
ENABLE_PHYSICAL_TIKTOK_SEND=false
# Windows Enter is a separate startup-only gate. Fill still requires manual ARM.
# CURRENT WINDOWS RELEASE STATE: PC-SEND-2B / release hardening.
# Scope: own LIVE, one Studio/operator, EN, manual approval, limited load.
# scripts/start-acceptance.ps1 sets the reviewed one-shot VM profile explicitly;
# defaults below do not authorize physical input. AUTO always starts OFF.
# Its atomic results are ignored work/acceptance/startup/<id>.json and latest.json.
# last-ready.json is a reuse candidate only; it never grants current readiness.
# Do not set ACCEPTANCE_LAUNCH_ID manually; it binds launcher/backend evidence.
ENABLE_PHYSICAL_WINDOWS_SEND=false
TIKTOK_TRANSPORT=android
# Configure locally; never infer identity from a window title/display name.
# WINDOWS__EXECUTABLE_PATH=C:/absolute/path/to/TikTok LIVE Studio.exe
# WINDOWS__PROCESS_ID=12345
# WINDOWS__BROADCASTER_USER_ID=123456789
WINDOWS__MANUAL_FILL_ENABLED=true
WINDOWS__ACCEPTANCE_ONE_SHOT=false
WINDOWS__ARM_TTL_SECONDS=600
WINDOWS__FOCUS_WATCH_SECONDS=15
WINDOWS__VERIFICATION_SECONDS=10
WINDOWS__COOLDOWN_SECONDS=3
INSTANCE_ID=default
ACCOUNT_LABEL=
# Use separate config directories, STATE_DIR, LOG_DIR and ports for independent instances.
STATE_DIR=data
MANUAL_DELIVERY_MIN_INTERVAL_SECONDS=3
# Optional absolute path to the installed adb.exe. Omit to resolve adb once from PATH.
# ADB_EXECUTABLE=C:/Android/platform-tools/adb.exe
# Only used by provider=openai or the explicit --ai-smoke command.
OPENAI_API_KEY=
# Required only for real mode; use your own account handle, without URL.
TIKTOK_USERNAME=
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
QUEUE_SIZE=1000
RECONNECT_INITIAL_SECONDS=2
RECONNECT_MAX_SECONDS=60
RECONNECT_MAX_ATTEMPTS=5
CONNECT_TIMEOUT_SECONDS=30
SHUTDOWN_TIMEOUT_SECONDS=5
FAKE_INTERVAL_SECONDS=1
# false: three messages and exit; true: repeat until Ctrl+C.
FAKE_REPEAT=false
PROJECT_CONFIG_PATH=config/project.yaml
KNOWLEDGE_PATH=config/bot_knowledge.yaml
FAKE_EXAMPLES_PATH=config/fake_ai_examples.yaml
