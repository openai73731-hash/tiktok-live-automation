# Safe default: no TikTok connection.
LIVE_MODE=fake
# Required only for real mode; use your own account handle, without URL.
TIKTOK_USERNAME=
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
QUEUE_SIZE=1000
RECONNECT_INITIAL_SECONDS=2
RECONNECT_MAX_SECONDS=60
CONNECT_TIMEOUT_SECONDS=30
SHUTDOWN_TIMEOUT_SECONDS=5
FAKE_INTERVAL_SECONDS=1
# false: three messages and exit; true: repeat until Ctrl+C.
FAKE_REPEAT=false
PROJECT_CONFIG_PATH=config/project.yaml
KNOWLEDGE_PATH=config/bot_knowledge.yaml
FAKE_EXAMPLES_PATH=config/fake_ai_examples.yaml
